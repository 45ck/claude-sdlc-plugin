#!/usr/bin/env node

/**
 * Artifact Sync Script
 *
 * Syncs documentation artifacts from the docs/ directory to the Storybook public/artifacts/ directory.
 * Supports both one-time sync and watch mode for automatic updates during development.
 *
 * Usage:
 *   node sync-artifacts.js          # One-time sync
 *   node sync-artifacts.js --watch  # Watch mode with automatic sync
 */

import chokidar from 'chokidar';
import fs from 'fs-extra';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Paths configuration
const DOCS_DIR = path.resolve(__dirname, '../../../docs');
const PUBLIC_ARTIFACTS = path.resolve(__dirname, '../public/artifacts');

/**
 * Sync artifacts from docs/ to public/artifacts/
 * Preserves directory structure and overwrites existing files
 */
async function syncArtifacts() {
  try {
    console.log('\nSyncing artifacts from docs/ to public/artifacts/...');
    console.log(`Source: ${DOCS_DIR}`);
    console.log(`Target: ${PUBLIC_ARTIFACTS}`);

    // Ensure source directory exists
    if (!await fs.pathExists(DOCS_DIR)) {
      console.warn(`⚠ Source directory does not exist: ${DOCS_DIR}`);
      console.log('Creating docs/ directory...');
      await fs.ensureDir(DOCS_DIR);

      // Create basic README
      const readmePath = path.join(DOCS_DIR, 'README.md');
      await fs.writeFile(readmePath, `# Documentation Artifacts

This directory contains all SDLC documentation artifacts.
Files in this directory are automatically synced to the Storybook planning hub.

## Structure

- \`req/\` - Requirements and user stories
- \`arch/\` - Architecture diagrams and decisions
- \`ux/\` - UX designs and user journeys
- \`test/\` - Test plans and strategies
- \`pm/\` - Project management artifacts
- \`ba/\` - Business analysis documents
- \`security/\` - Security documentation
- \`quality/\` - Quality assurance artifacts
- \`db/\` - Database schemas and migrations
- \`ops/\` - DevOps and deployment documentation

## Usage

1. Add your documentation files to the appropriate subdirectory
2. Artifacts are automatically synced to Storybook
3. View them at http://localhost:6006
`);
      console.log('✓ Created docs/ directory with README');
    }

    // Ensure target directory exists
    await fs.ensureDir(PUBLIC_ARTIFACTS);

    // Copy all files from docs/ to public/artifacts/
    await fs.copy(DOCS_DIR, PUBLIC_ARTIFACTS, {
      overwrite: true,
      errorOnExist: false,
      filter: (src) => {
        // Exclude hidden files and directories (e.g., .git, .DS_Store)
        const basename = path.basename(src);
        if (basename.startsWith('.') && basename !== '.') {
          return false;
        }

        // Exclude node_modules
        if (src.includes('node_modules')) {
          return false;
        }

        return true;
      },
    });

    // Count synced files
    const files = await getFileCount(PUBLIC_ARTIFACTS);

    console.log(`✓ Artifacts synced successfully (${files} files)`);
    console.log(`✓ Target: ${PUBLIC_ARTIFACTS}\n`);

    return true;
  } catch (error) {
    console.error('✗ Error syncing artifacts:', error);
    if (error instanceof Error) {
      console.error(`  ${error.message}`);
    }
    return false;
  }
}

/**
 * Recursively count files in a directory
 */
async function getFileCount(dir) {
  let count = 0;

  try {
    if (!await fs.pathExists(dir)) {
      return 0;
    }

    const items = await fs.readdir(dir, { withFileTypes: true });

    for (const item of items) {
      const itemPath = path.join(dir, item.name);

      if (item.isDirectory()) {
        count += await getFileCount(itemPath);
      } else if (item.isFile()) {
        count++;
      }
    }
  } catch (error) {
    console.warn(`Warning: Could not count files in ${dir}:`, error);
  }

  return count;
}

/**
 * Get relative path for display
 */
function getRelativePath(filepath) {
  try {
    return path.relative(DOCS_DIR, filepath);
  } catch {
    return filepath;
  }
}

/**
 * Watch mode - continuously sync on file changes
 */
async function watchMode() {
  console.log('='.repeat(60));
  console.log('Artifact Sync - Watch Mode');
  console.log('='.repeat(60));

  // Initial sync
  const success = await syncArtifacts();
  if (!success) {
    console.error('Initial sync failed. Exiting...');
    process.exit(1);
  }

  console.log('Watching docs/ directory for changes...');
  console.log('Press Ctrl+C to stop\n');

  // Configure watcher
  const watcher = chokidar.watch(DOCS_DIR, {
    ignored: [
      /(^|[\/\\])\../, // ignore dotfiles
      '**/node_modules/**', // ignore node_modules
    ],
    persistent: true,
    ignoreInitial: true,
    awaitWriteFinish: {
      stabilityThreshold: 300,
      pollInterval: 100,
    },
  });

  // Debounce sync to avoid multiple rapid syncs
  let syncTimeout = null;
  const debouncedSync = () => {
    if (syncTimeout) {
      clearTimeout(syncTimeout);
    }
    syncTimeout = setTimeout(() => {
      syncArtifacts();
    }, 500);
  };

  // Watch events
  watcher
    .on('add', filepath => {
      console.log(`[${new Date().toLocaleTimeString()}] File added: ${getRelativePath(filepath)}`);
      debouncedSync();
    })
    .on('change', filepath => {
      console.log(`[${new Date().toLocaleTimeString()}] File changed: ${getRelativePath(filepath)}`);
      debouncedSync();
    })
    .on('unlink', filepath => {
      console.log(`[${new Date().toLocaleTimeString()}] File removed: ${getRelativePath(filepath)}`);
      debouncedSync();
    })
    .on('addDir', dirpath => {
      console.log(`[${new Date().toLocaleTimeString()}] Directory added: ${getRelativePath(dirpath)}`);
      debouncedSync();
    })
    .on('unlinkDir', dirpath => {
      console.log(`[${new Date().toLocaleTimeString()}] Directory removed: ${getRelativePath(dirpath)}`);
      debouncedSync();
    })
    .on('error', error => {
      console.error('Watcher error:', error);
    });

  // Handle graceful shutdown
  process.on('SIGINT', () => {
    console.log('\n\nStopping watcher...');
    watcher.close();
    console.log('✓ Watcher stopped');
    process.exit(0);
  });
}

/**
 * Main execution
 */
async function main() {
  // Check for --watch flag
  const isWatchMode = process.argv.includes('--watch') || process.argv.includes('-w');

  if (isWatchMode) {
    await watchMode();
  } else {
    // One-time sync
    console.log('='.repeat(60));
    console.log('Artifact Sync - One-time');
    console.log('='.repeat(60));

    const success = await syncArtifacts();
    process.exit(success ? 0 : 1);
  }
}

// Run main function
main().catch(error => {
  console.error('Fatal error:', error);
  process.exit(1);
});
