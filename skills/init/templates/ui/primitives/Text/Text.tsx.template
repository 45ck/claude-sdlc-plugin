import React from 'react';
import './Text.css';

export interface TextProps {
  /**
   * The HTML element to render
   */
  as?: 'p' | 'span' | 'div' | 'label' | 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';

  /**
   * The visual style variant
   */
  variant?:
    | 'displayLarge'
    | 'displayMedium'
    | 'displaySmall'
    | 'heading1'
    | 'heading2'
    | 'heading3'
    | 'bodyLarge'
    | 'bodyMedium'
    | 'bodySmall'
    | 'labelLarge'
    | 'labelMedium'
    | 'labelSmall'
    | 'codeLarge'
    | 'codeMedium'
    | 'codeSmall';

  /**
   * Text alignment
   */
  align?: 'left' | 'center' | 'right' | 'justify';

  /**
   * Text color
   */
  color?: 'primary' | 'secondary' | 'tertiary' | 'disabled' | 'inverse' | 'link' | 'danger' | 'success';

  /**
   * Font weight override
   */
  weight?: 'normal' | 'medium' | 'semibold' | 'bold';

  /**
   * Whether to truncate text with ellipsis
   */
  truncate?: boolean;

  /**
   * Number of lines to clamp (line-clamp)
   */
  lineClamp?: number;

  /**
   * Additional CSS class
   */
  className?: string;

  /**
   * Content to render
   */
  children: React.ReactNode;
}

/**
 * Text component for consistent typography throughout the application.
 * Supports semantic HTML elements with design system styling.
 */
export const Text = React.forwardRef<HTMLElement, TextProps>(
  (
    {
      as: Component = 'p',
      variant = 'bodyMedium',
      align,
      color = 'primary',
      weight,
      truncate = false,
      lineClamp,
      className = '',
      children,
      ...props
    },
    ref
  ) => {
    const classNames = [
      'text',
      `text--${variant}`,
      `text--color-${color}`,
      align && `text--align-${align}`,
      weight && `text--weight-${weight}`,
      truncate && 'text--truncate',
      lineClamp && 'text--line-clamp',
      className,
    ]
      .filter(Boolean)
      .join(' ');

    const style = lineClamp
      ? ({
          '--line-clamp': lineClamp,
          WebkitLineClamp: lineClamp,
        } as React.CSSProperties)
      : undefined;

    return (
      <Component
        ref={ref as any}
        className={classNames}
        style={style}
        {...props}
      >
        {children}
      </Component>
    );
  }
);

Text.displayName = 'Text';
